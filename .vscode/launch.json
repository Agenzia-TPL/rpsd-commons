{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Current Python File with uv",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "console": "integratedTerminal"
        },
        {
            "name": "app",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}/src/rpsd_commons",
            "program": "app.py",
            "justMyCode": false
        },
        {
            "name": "FastAPI Ingest Example",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/examples/fastapi_ingest_app/src/fastapi_ingest_app/main.py",
            "cwd": "${workspaceFolder}/examples/fastapi_ingest_app",
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}