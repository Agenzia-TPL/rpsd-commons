# rpsd-storage configuration
# Copy this file to .env and fill in the values you need.
# The .env file is git-ignored; never commit real credentials.
#
# This file is used for:
#   - Standalone use of StorageSettings (pass _env_file=".env" explicitly)
#   - Live S3 integration tests (packages/rpsd-storage/.env is loaded by the test fixture)

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Active storage backend: s3 | fs | http
#STORAGE__PROVIDER=fs

# Skip saving when file content is identical to what is already stored
#STORAGE__COMPARE_BEFORE_SAVE=false

# ---------------------------------------------------------------------------
# S3 provider  (required when STORAGE__PROVIDER=s3)
# ---------------------------------------------------------------------------
#STORAGE__S3__BUCKET_NAME=my-bucket

# AWS credentials (optional — boto3 falls back to IAM role / ~/.aws/credentials)
#STORAGE__S3__AWS_ACCESS_KEY_ID=AKIA...
#STORAGE__S3__AWS_SECRET_ACCESS_KEY=...
#STORAGE__S3__AWS_SESSION_TOKEN=...   # only needed for temporary/assumed-role creds

#STORAGE__S3__REGION_NAME=eu-west-1

# Custom endpoint for LocalStack or MinIO (leave unset for real AWS)
#STORAGE__S3__ENDPOINT_URL=http://localhost:4566

# ---------------------------------------------------------------------------
# Filesystem provider
# ---------------------------------------------------------------------------
#STORAGE__FS__BASE_PATH=/tmp/ingested

# ---------------------------------------------------------------------------
# HTTP provider
# ---------------------------------------------------------------------------
#STORAGE__HTTP__TIMEOUT=30.0
