# rpsd-commons Environment Variables Example
# Copy this file to .env and adjust values as needed

# ============================================================================
# Storage Settings (rpsd-storage)
# ============================================================================

# Storage provider type: "fs" (filesystem), "s3" (AWS S3), or "http" (HTTP URLs)
STORAGE__PROVIDER=fs

# Filesystem provider settings (used when STORAGE__PROVIDER=fs)
STORAGE__FS__BASE_PATH=/tmp/ingested

# S3 provider settings (required when STORAGE__PROVIDER=s3)
# STORAGE__S3__BUCKET_NAME=my-bucket-name
#
# Optional S3 credentials — if omitted, boto3 falls back to the standard AWS
# credential chain (IAM role, ~/.aws/credentials, environment variables, etc.)
# STORAGE__S3__AWS_ACCESS_KEY_ID=AKIA...
# STORAGE__S3__AWS_SECRET_ACCESS_KEY=...
# STORAGE__S3__AWS_SESSION_TOKEN=...        (only needed for temporary credentials)
# STORAGE__S3__REGION_NAME=eu-west-1
# STORAGE__S3__ENDPOINT_URL=http://localhost:4566  (LocalStack/MinIO only; omit for real AWS)

# HTTP provider settings (used when STORAGE__PROVIDER=http)
# STORAGE__HTTP__TIMEOUT=30.0

# ============================================================================
# Transport Settings (rpsd-transport)
# ============================================================================

# API key for transport authentication (optional)
# If set, incoming requests must include this key in headers
# TRANSPORT__API_KEY=your-secret-key-here

# ============================================================================
# Notes
# ============================================================================
# - Settings use double underscore (__) as nested delimiter
# - Environment variables override .env file values
# - All settings have sensible defaults
# - Only STORAGE__S3__BUCKET_NAME is required (when using S3 provider)
